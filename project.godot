;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Red Rum"
run/main_scene="uid://cjws0ht64l1dx"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

